# Copy this file to e2e/.env and fill in real values before running tests.
# e2e/.env is gitignored — never commit real credentials.

# Angular dev server URL (playwright.config.ts webServer auto-starts `npm start` on this URL)
PLAYWRIGHT_BASE_URL=http://localhost:4200

# ASP.NET API URL — must match src/environments/environment.ts BASE_URL.
# Playwright does NOT start this for you; run the API separately before testing.
API_BASE_URL=https://localhost:5000

# Credentials for a real, seeded test workshop account (used by e2e/fixtures/auth.fixture.ts
# to log in via POST /api/auth/login and seed sessionStorage — no UI login per test).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
