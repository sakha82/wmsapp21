# Copy this file to e2e/.env and fill in real values before running tests.
# e2e/.env is gitignored — never commit real credentials.

# Angular dev server URL (playwright.config.ts webServer auto-starts `npm start` on this URL)
PLAYWRIGHT_BASE_URL=http://localhost:4200

# ASP.NET API URL — must match src/environments/environment.ts BASE_URL.
# Playwright does NOT start this for you; run the API separately before testing.
API_BASE_URL=https://localhost:5000

# Credentials for 3 real, seeded test accounts under the SAME wmsId/tenant (used by
# e2e/global-setup.ts to log in once each via POST /api/auth/login and cache sessions;
# e2e/fixtures/auth.fixture.ts then assigns one session per Playwright worker so parallel
# workers never share a session — no UI login per test). All 3 accounts must belong to the
# same wmsId so they see the same customers/products/etc. See Scripts/CreateTestUsers (in
# the wms container repo, sibling to this one) for how these were created.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

TEST_USER_2_EMAIL=
TEST_USER_2_PASSWORD=

TEST_USER_3_EMAIL=
TEST_USER_3_PASSWORD=
